{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/lambda.js",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 60,
        "includeFiles": "dist/**"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/dist/lambda.js" }]
}
